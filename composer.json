{
    "name": "magicoli/container-tools",
    "description": "PHP library and command-line adapter for managing containers with Podman.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Olivier van Helden",
            "homepage": "https://magiiic.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Magicoli\\ContainerTools\\": "src/"
        }
    },
    "bin": [
        "bin/container-tools.php"
    ],
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
